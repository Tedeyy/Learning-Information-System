CREATE DATABASE IF NOT EXISTS eduready_lis_db;
USE eduready_lis_db;

-- 1. Create subjects first because other tables reference it
CREATE TABLE subjects (
    id INT AUTO_INCREMENT PRIMARY KEY,
    subject_name VARCHAR(100) NOT NULL,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Create learning_materials
CREATE TABLE learning_materials (
    id INT AUTO_INCREMENT PRIMARY KEY,
    subject_id INT NOT NULL,
    title VARCHAR(150) NOT NULL,
    content_description TEXT,
    video_url VARCHAR(255) DEFAULT NULL,
    file_url VARCHAR(255) DEFAULT NULL, -- Path to the uploaded PDF/Doc
    material_type ENUM('text', 'video', 'file') NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE CASCADE
);

-- 3. Create flashcards
CREATE TABLE flashcards (
    id INT AUTO_INCREMENT PRIMARY KEY,
    subject_id INT NOT NULL,
    question TEXT NOT NULL,
    option_a VARCHAR(255) NOT NULL,
    option_b VARCHAR(255) NOT NULL,
    option_c VARCHAR(255),
    option_d VARCHAR(255),
    correct_option CHAR(1) NOT NULL, -- e.g., 'A', 'B', 'C', or 'D'
    explanation TEXT, -- This shows when the user picks the wrong answer
    FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE CASCADE
);